# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=replace-me-with-a-generated-key

# Optional. Defaults to a local SQLite file when unset.
# DATABASE_URL=postgres://fonix:password@localhost:5432/fonix

# Only read by config/settings/production.py -- local.py hardcodes safe
# development values so a fresh clone runs without any of this.
# ALLOWED_HOSTS=fonix.example.com
# CORS_ALLOWED_ORIGINS=https://fonix.example.com
