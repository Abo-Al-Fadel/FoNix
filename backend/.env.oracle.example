# Copy to `.env` on the Oracle VM (never commit the copy).
#
#   cp .env.oracle.example .env
#
# Generate SECRET_KEY *on the VM*:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# Generate POSTGRES_PASSWORD the same way.

SECRET_KEY=replace-me
POSTGRES_PASSWORD=replace-me-with-a-long-random-string

# Public hostname of THIS api box. No https://, no trailing slash.
# Example: api.yourdomain.com
# No domain yet? Use sslip.io with your public IP, dots to dashes:
#   129.146.12.34  →  129-146-12-34.sslip.io
API_DOMAIN=api.example.com

# Let's Encrypt contact (optional but recommended)
CADDY_EMAIL=you@example.com

# Comma-separated hostnames, no scheme.
ALLOWED_HOSTS=api.example.com

# The Vercel origin, no trailing slash. You get this after creating the
# Vercel project (step in the chat). Then rebuild the frontend with
# VITE_API_BASE_URL=https://api.example.com/api
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
CSRF_TRUSTED_ORIGINS=https://api.example.com
FRONTEND_ORIGIN=https://your-app.vercel.app
