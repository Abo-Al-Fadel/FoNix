# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
#
#   cp .env.example .env
#
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=replace-me-with-a-generated-key

# Optional locally. Defaults to a SQLite file (see config/settings/local.py).
# Required in production — there is no SQLite fallback there.
# DATABASE_URL=postgres://fonix:password@localhost:5432/fonix

# Password-reset emails point at this origin (no trailing slash).
# local.py hardcodes http://localhost:5173; production requires the public site.
# FRONTEND_ORIGIN=http://localhost:5173

# Only read by config/settings/production.py -- local.py hardcodes safe
# development values so a fresh clone runs without any of this.
# ALLOWED_HOSTS=api.example.com
# CORS_ALLOWED_ORIGINS=https://www.example.com
# CSRF_TRUSTED_ORIGINS=https://api.example.com
# FRONTEND_ORIGIN=https://www.example.com
# DEFAULT_FROM_EMAIL=FoNix <noreply@example.com>
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
