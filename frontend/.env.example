# Copy to `.env`. Vite only exposes variables prefixed with VITE_ to client
# code -- a guard against accidentally bundling a secret into a public file.
#
# These are baked in at *build* time. Changing them on a host without
# rebuilding does nothing. See docs/DEPLOY.md.

VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Public site origin, no trailing slash. Used to write sitemap.xml on build.
# Leave unset locally; set it on Vercel to the production URL.
# VITE_SITE_URL=https://www.example.com
